# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the app, used in email links (required in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email via Resend (password reset codes + security notices).
# Without these, password reset falls back to Supabase's built-in email (link only).
RESEND_API_KEY=
EMAIL_FROM="VentoryPoint <no-reply@yourdomain.com>"
# Shown in the reset email; match Supabase Auth -> Email OTP expiration (default 3600s = 60 min)
RESET_CODE_MINUTES=60

# Event worker + health endpoint password (>= 32 random characters)
EVENT_WORKER_SECRET=
# Staff-only /internal area: comma-separated emails
PLATFORM_ADMIN_EMAILS=
# Developer event console in production (optional)
# ENABLE_DEV_CONSOLE=true
